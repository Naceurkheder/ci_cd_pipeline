pipeline {
    agent any 
    
    stages {
        stage('Checkout Code') {
            steps {
                echo 'Pulling monorepo code from GitHub...'
                checkout scm
            }
        }
        
        stage('Concurrent Build, Analyze & Deploy') {
            parallel {
                
                stage('Spring Boot Backend') {
                    agent {
                        docker { 
                            image 'maven:3.9-eclipse-temurin-21' 
                            args '-u root:root -v sonar-cache:/root/.sonar/cache' 
                        }
                    }
                    steps {
                        dir('back_end/demo') {
                            echo 'Configuring Maven cleanly via Jenkins native step...'
                            
                            sh '''
                            cat <<EOF > settings.xml
                            <settings>
                              <mirrors>
                                <mirror>
                                  <id>nexus</id>
                                  <mirrorOf>*</mirrorOf>
                                  <url>http://192.168.56.31:8081/repository/maven-public/</url>
                                </mirror>
                              </mirrors>
                            </settings>
                            EOF
                            '''
                            
                            echo 'Compiling Java, running tests, and pushing to SonarQube...'
                            withSonarQubeEnv(installationName: 'sonar-server') {
                                sh 'mvn clean package -s settings.xml -Dmaven.test.failure.ignore=true -X' 
                                sh 'mvn sonar:sonar -s settings.xml -Dsonar.verbose=true -Dsonar.qualitygate.wait=true' 
                            }
                            
                            echo 'Backend SonarQube passed. Uploading JAR to Nexus...'
                            nexusArtifactUploader(
                                nexusVersion: 'nexus3',
                                protocol: 'http',
                                nexusUrl: '192.168.56.31:8081', 
                                groupId: 'com.demo',
                                version: '1.0.0',
                                repository: 'maven-releases', 
                                credentialsId: 'nexus-credentials',
                                artifacts: [
                                    [
                                        artifactId: 'backend-demo', 
                                        classifier: '', 
                                        file: 'target/demo-0.0.1-SNAPSHOT.jar', 
                                        type: 'jar'
                                    ]
                                ]
                            )
                        }
                    }
                }

                stage('Angular Frontend') {
                    agent {
                        docker { 
                            image 'node:22' 
                            args '-u root:root -v sonar-cache:/root/.sonar/cache'
                        }
                    }
                    steps {
                        dir('demo_frontend') {
                            echo 'Setting npm registry to Nexus Proxy...'
                            
                            // Nexus caching for standard npm packages
                            sh 'npm config set registry http://192.168.56.31:8081/repository/npm-proxy/'
                            
                            echo 'Building Angular, running tests, and pushing to SonarQube...'
                            sh 'npm install --no-audit --no-fund --loglevel verbose'
                            sh 'npm run build'
                            withSonarQubeEnv(installationName: 'sonar-server') {
                                // Added --yes to prevent prompt hanging.
                                // Replaced public registry with Nexus proxy to enable sonarqube-scanner caching.
                                sh '''
                                npx --yes --registry=http://192.168.56.31:8081/repository/npm-proxy/ sonarqube-scanner \
                                  -X \
                                  -Dsonar.projectKey=demo-frontend \
                                  -Dsonar.sources=src \
                                  -Dsonar.host.url=https://cathouse-doing-extended.ngrok-free.dev \
                                  -Dsonar.qualitygate.wait=true \
                                  -Dsonar.javascript.node.maxspace=4096
                                '''
                            }
                            
                            echo 'Frontend SonarQube passed. Compressing and uploading to Nexus...'
                            sh 'tar -czvf frontend-app.tar.gz dist/'
                            
                            nexusArtifactUploader(
                                nexusVersion: 'nexus3',
                                protocol: 'http',
                                nexusUrl: '192.168.56.31:8081', 
                                groupId: 'com.demo',
                                version: '1.0.0',
                                repository: 'frontend-releases', 
                                credentialsId: 'nexus-credentials',
                                artifacts: [
                                    [
                                        artifactId: 'angular-frontend', 
                                        classifier: '', 
                                        file: 'frontend-app.tar.gz', 
                                        type: 'tar.gz'
                                    ]
                                ]
                            )
                        }
                    }
                }
                
            }
        }
    }
}
